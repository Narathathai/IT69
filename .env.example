# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql://uni_admin:uni_secret_pass@localhost:5432/uni_it_hub?schema=public"

# Redis Cache & Message Broker (Redis Streams)
REDIS_URL="redis://localhost:6379"

# Security & Auth
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="nextauth-secret-key-change-in-production"

# External Legacy Systems (Mock / Real)
LDAP_URL="ldap://ldap.university.ac.th:389"
LDAP_BIND_DN="cn=service_account,dc=university,dc=ac,dc=th"
LDAP_BIND_PASSWORD="ldap_service_secret"
SIS_API_URL="https://reg.university.ac.th/api/v1"
SIS_API_KEY="sis_api_token_here"

# SMS Gateway Configuration
SMS_API_URL="https://sms-gateway.provider.co.th/api/v2/send"
SMS_API_KEY="sms_provider_api_key"
SMS_SENDER_NAME="UniIT"

# AI Service (Google Gemini / OpenAI)
AI_API_KEY="gemini-or-openai-api-key"
AI_MODEL_NAME="gemini-1.5-flash"
